<?xml version="1.0" encoding="utf-8"?>
<!--
  Every phone destination. Order and ids must match MOBILE_TABS in
  src/components/mobile/MobileTabBar.tsx — the web app owns navigation and this
  bar only mirrors it. Which items show, and their localized titles, arrive
  over NativeShell.configure (ShellChrome.setTabs hides the rest).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/operon_tab_chats"
        android:icon="@drawable/ic_message_square"
        android:title="Chats" />
    <item
        android:id="@+id/operon_tab_assistant"
        android:icon="@drawable/ic_sparkles"
        android:title="Assistant"
        android:visible="false" />
    <item
        android:id="@+id/operon_tab_channel"
        android:icon="@drawable/ic_layout_dashboard"
        android:title="Board" />
    <item
        android:id="@+id/operon_tab_changes"
        android:icon="@drawable/ic_file_diff"
        android:title="Changes" />
    <item
        android:id="@+id/operon_tab_more"
        android:icon="@drawable/ic_menu"
        android:title="More" />
</menu>
