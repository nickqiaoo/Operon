# Use the Metrics and Logs write endpoints and instance IDs shown in your Grafana Cloud stack.
# Create a Cloud Access Policy token scoped to metrics:write and logs:write only.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=METRICS_INSTANCE_ID
GRAFANA_CLOUD_LOKI_URL=https://logs-REGION.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=LOGS_INSTANCE_ID
GRAFANA_CLOUD_TOKEN=REPLACE_WITH_WRITE_ONLY_TOKEN
