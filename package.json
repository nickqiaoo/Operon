    "operon-agents": "0.1.0-alpha.3",
    "operon-agents-core": "0.1.0-alpha.3",
    "operon-agents-peers": "0.1.0-alpha.3",
    "posthog-node": "^5.28.0",
    "react-intl": "^10.1.11",
    "remark-breaks": "^4.0.0",
