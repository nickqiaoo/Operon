{
  "name": "operon",
  "version": "1.3.30",
  "author": "nickqiao",
  "description": "AI Vibe Coding Tool",
  "main": "dist-electron/main.js",
  "type": "module",
  "workspaces": [
    "agent-runtime",
    "server",
    "packages/*"
  ],
  "overrides": {
    "undici": "^6.21.1",
    "node-gyp": "^10.0.0",
    "@ai-sdk/provider": "^4.0.9"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs",
    "clean:build": "rm -rf dist dist-electron dist-operon-runtime",
    "build:operon-runtime": "node scripts/build-operon-runtime.mjs",
    "build:extension-market": "node scripts/build-extension-market.mjs",
    "deploy:extension-market": "npm run build:extension-market && wrangler deploy --config cloudflare/extension-market/wrangler.jsonc",
    "build:computer-use-native": "node scripts/build-computer-use-native.mjs",
    "deploy:web": "npm --prefix web run deploy",
    "build:web": "OPERON_SKIP_ELECTRON=1 OPERON_BUILD_TARGET=web vite build",
    "build:web:app": "VITE_BROKER_URL=https://operon-api.chatcode.top npm run build:web",
    "verify:pwa-recovery": "node scripts/verify-pwa-recovery.mjs",
    "deploy:web:app": "npm run build:web:app && wrangler pages deploy dist-web --project-name operon-app --commit-dirty=true",
    "build:web:native": "OPERON_NATIVE=1 npm run build:web:app",
    "ios:sync": "npm run build:web:native && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "npm run build:web:native && cap sync android",
    "android:open": "cap open android",
    "dev:web": "OPERON_SKIP_ELECTRON=1 OPERON_BUILD_TARGET=web vite",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "dev": "npm run dev:app",
    "dev:app": "vite",
    "dev:profile": "VITE_REACT_DEVTOOLS=1 REACT_FAST_REFRESH=false concurrently -n app,devtools -c green,blue \"npm run dev\" \"npm run dev:react-devtools\"",
    "dev:react-devtools": "react-devtools --port 8097",
    "dev:renderer": "vite",
    "build": "TARGET_ARCH=arm64 npm run check:optional-deps && TARGET_ARCH=arm64 npm run rebuild:native && npm run clean:build && tsc && npm run build:operon-runtime && npm run build:computer-use-native && vite build && electron-builder",
    "build:mac": "TARGET_ARCH=arm64 npm run check:optional-deps && TARGET_ARCH=arm64 npm run rebuild:native && npm run clean:build && tsc && npm run build:operon-runtime && npm run build:computer-use-native && vite build && electron-builder --mac",
    "build:mac:unsigned": "TARGET_ARCH=arm64 npm run check:optional-deps && TARGET_ARCH=arm64 npm run rebuild:native && npm run clean:build && CSC_IDENTITY_AUTO_DISCOVERY=false tsc && npm run build:operon-runtime && npm run build:computer-use-native && vite build && electron-builder --mac",
    "build:mac:intel": "TARGET_ARCH=x64 npm run check:optional-deps && TARGET_ARCH=x64 npm run rebuild:native && npm run clean:build && tsc && npm run build:operon-runtime && npm run build:computer-use-native && vite build && electron-builder --mac --config electron-builder-intel.yml",
    "build:mac:all": "bash scripts/build-all-mac.sh",
    "release": "bash scripts/publish-release.sh",
    "preview": "vite preview",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore '**/*.d.ts' --out-file src/i18n/extracted/en.json --format simple",
    "electron:dev": "npm run dev",
    "electron:build": "npm run check:optional-deps && npm run rebuild:native && npm run clean:build && npm run build:operon-runtime && npm run build:computer-use-native && vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:computer-use:e2e": "OPERON_RUN_COMPUTER_USE_FIXTURE_E2E=1 vitest run packages/computer-use/desktop-appkit-fixture.e2e.test.ts packages/computer-use/desktop-electron-fixture.e2e.test.ts --no-file-parallelism --reporter=verbose",
    "test:e2e": "playwright test --project=dev",
    "test:e2e:ci": "OPERON_TEST_MODE=fake PLAYWRIGHT_CI=1 playwright test --project=ci",
    "test:e2e:real": "OPERON_TEST_MODE=real playwright test --project=ci",
    "test-server": "tsx server/src/test-server.ts",
    "test-renderer": "OPERON_SKIP_ELECTRON=1 vite --host 127.0.0.1 --port 4101 --strictPort",
    "check:optional-deps": "node scripts/check-optional-deps.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/google": "^4.0.58",
    "@ai-sdk/openai": "^4.0.52",
